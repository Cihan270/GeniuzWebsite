# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore en komt dus nooit in git terecht.
#
#   cp .env.example .env.local
#
# Zet dezelfde variabelen ook in je hostingomgeving (Vercel → Settings →
# Environment Variables) — .env.local geldt alleen lokaal.

# --- E-mail (verplicht) -----------------------------------------------------
# Zonder RESEND_API_KEY verstuurt het contactformulier niets en krijgt de
# bezoeker een foutmelding. De AI Opportunity Scan logt de verloren lead.
# Key aanmaken: https://resend.com/api-keys
RESEND_API_KEY=

# Afzender. Het domein moet geverifieerd zijn in Resend, anders weigert de API
# de verzending. Nog niet geverifieerd? Gebruik tijdelijk:
#   RESEND_FROM_EMAIL="Geniuz <onboarding@resend.dev>"
# Domein verifiëren: https://resend.com/domains
RESEND_FROM_EMAIL="Geniuz <noreply@geniuzaic.com>"

# Mailbox waar contactaanvragen binnenkomen.
CONTACT_TO_EMAIL=

# Mailbox waar scan-leads binnenkomen. Mag hetzelfde adres zijn.
OPPORTUNITY_SCAN_TO_EMAIL=

# --- Site -------------------------------------------------------------------
# Productiedomein zonder slash aan het eind. Bepaalt canonical-URL's, de
# sitemap en OG-tags. Laat leeg voor lokaal; zet in productie het echte domein.
NEXT_PUBLIC_SITE_URL=
